# Any PostgreSQL database works: local, Docker (see docker-compose.yml),
# Neon, Supabase, Railway, RDS... Hosted providers usually need ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumora

# Auth (generate a secret with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Free TMDB credentials: https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (preferred) or the v3 "API Key".
TMDB_TOKEN=
# TMDB_API_KEY=

# Optional: canonical URL used for metadata and social previews
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
